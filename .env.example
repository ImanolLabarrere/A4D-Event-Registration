# ==============================================================================
# A4D Event Registration - Environment Configuration Template
# Copy this file to .env for local development. Never commit real secrets.
# ==============================================================================

# Application port (Cloud Run sets PORT automatically; default 3000)
PORT=3000

# Node environment: 'development', 'test', or 'production'
NODE_ENV=development

# Database connection URL (PostgreSQL 16)
DATABASE_URL=postgresql://a4d:change-me@localhost:5433/a4d?schema=public

# Test database connection URL (used for local Vitest test runs)
DATABASE_URL_TEST=postgresql://a4d:change-me@localhost:5433/a4d_test?schema=public

# Session duration in hours (default: 8)
SESSION_TTL_HOURS=8

# Initial seed password for demo accounts (required for database seeding)
SEED_PASSWORD=change-me-demo

# Force database re-seeding even if records exist (default: false)
FORCE_SEED=false
